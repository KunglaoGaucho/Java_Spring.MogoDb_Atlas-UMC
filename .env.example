# ---------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com seus valores.
# O .env está no .gitignore e NUNCA deve ser commitado.
# ---------------------------------------------------------------

# String de conexão do MongoDB Atlas (Database > Connect > Drivers > Java).
# Se a senha tiver caracteres especiais (@ : / ? # [ ]), use URL-encoding.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=sentinela
MONGODB_DATABASE=sentinela

# Administrador criado automaticamente na primeira execução
SENTINELA_ADMIN_EMAIL=admin@exemplo.com
SENTINELA_ADMIN_SENHA=TroqueEstaSenha#2026

# Identidade visual (opcional)
SENTINELA_NOME=Sentinela
SENTINELA_TEMA=aurora

# Segurança (opcional)
SENTINELA_MAX_TENTATIVAS=5
SENTINELA_BLOQUEIO_MINUTOS=15
SENTINELA_DOMINIO_CADASTRO=

# Sessão (opcional). Em produção com HTTPS, use SENTINELA_COOKIE_SEGURO=true
SENTINELA_SESSAO_MINUTOS=30
SENTINELA_COOKIE_SEGURO=false
